<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minWidth="600.0" minHeight="450.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ch.samt.qualityfitness.controller.TemplateEditController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" left="15" right="15" bottom="10"/></padding>
            <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="10">
                <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
            </GridPane>
            <Label fx:id="errorLabel" textFill="RED" wrapText="true" visible="false" managed="false"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="10">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </BorderPane.margin>
            <HBox spacing="10">
                <Button fx:id="addExerciseButton" text="Add exercise" onAction="#onAddExercise"/>
                <Button fx:id="editExerciseButton" text="Edit exercise" onAction="#onEditExercise"/>
                <Button fx:id="removeExerciseButton" text="Remove exercise" onAction="#onRemoveExercise"/>
                <Button fx:id="moveUpButton" text="Move up" onAction="#onMoveUp"/>
                <Button fx:id="moveDownButton" text="Move down" onAction="#onMoveDown"/>
            </HBox>
            <TableView fx:id="exercisesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="exerciseNameColumn" text="Exercise" prefWidth="200"/>
                    <TableColumn fx:id="setsColumn" text="Sets" prefWidth="80"/>
                    <TableColumn fx:id="repsColumn" text="Reps per set" prefWidth="250"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" left="15" right="15" bottom="15"/></padding>
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="Save" onAction="#onSave" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>