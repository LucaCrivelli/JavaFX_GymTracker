<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minWidth="500.0" minHeight="400.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ch.samt.qualityfitness.TemplatesController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" left="15" right="15" bottom="10"/></padding>
            <Label text="Templates" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Button fx:id="addButton" text="Add" onAction="#onAdd"/>
                <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tableView">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="300"/>
                <TableColumn fx:id="deleteColumn" text="Delete" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
</BorderPane>