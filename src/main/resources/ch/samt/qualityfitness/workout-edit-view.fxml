<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minWidth="650.0" minHeight="500.0" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ch.samt.qualityfitness.WorkoutEditController">
    <top>
        <VBox spacing="10">
            <padding><Insets top="15" left="15" right="15" bottom="10"/></padding>
            <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">
                <Label text="Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

                <Label text="Start date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <HBox spacing="5" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <DatePicker fx:id="startDatePicker"/>
                    <Spinner fx:id="startHourSpinner" prefWidth="70" editable="true"/>
                    <Spinner fx:id="startMinuteSpinner" prefWidth="70" editable="true"/>
                </HBox>

                <Label text="End date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <HBox spacing="5" GridPane.rowIndex="2" GridPane.columnIndex="1">
                    <DatePicker fx:id="endDatePicker"/>
                    <Spinner fx:id="endHourSpinner" prefWidth="70" editable="true"/>
                    <Spinner fx:id="endMinuteSpinner" prefWidth="70" editable="true"/>
                </HBox>
            </GridPane>

            <Label fx:id="errorLabel" textFill="RED" wrapText="true" visible="false" managed="false"/>
            <Button fx:id="addExerciseButton" text="Add exercise" onAction="#onAddExercise"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <BorderPane.margin>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </BorderPane.margin>
            <VBox fx:id="exercisesContainer" spacing="20"/>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="10" left="15" right="15" bottom="15"/></padding>
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="Save" onAction="#onSave" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>